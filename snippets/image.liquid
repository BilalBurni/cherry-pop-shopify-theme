{%- doc -%}
  Renders the <img> element using provided image object

  @param {object} image - image object
  @param {number} [height] - custom image height
  @param {string} [class] - additional classes
  @param {string} [text_fallback] - text to display if image is blank
  @param {boolean} [unset_image_tag] - if true, ignores the image focal point
  @param {string} [style] - additional styles
  @param {string} [alt_text_fallback] - Optional text to display if image alt text is blank
  @param {string} [loading] - Image loading strategy ('lazy' or 'eager')
  @param {string} [fetchpriority] - Image fetch priority ('high', 'low', 'auto')

  @example
  {% render 'image', image: product.featured_image, height: 300, class: 'product-image' %}
{%- enddoc -%}
{% if image != blank %}
  {% assign image_alt_text = image.alt | default: alt_text_fallback | default: '' %}
  {% assign style_value = style | default: '' %}
  {% assign image_loading = loading | default: 'lazy' %}
  {% assign image_fetchpriority = fetchpriority | default: 'auto' %}

  {% if unset_image_tag %}
    {% assign style_value = style_value | append: 'object-position: inherit;' %}
  {% endif %}

  {% if height != blank %}
    {% assign image_height = height %}
    {% assign image_height_2x = height | times: 2 %}
    {% assign image_height_3x = height | times: 3 %}

    {% capture image_srcset -%}
      {{ image | image_url: height: image_height }} 1x, {{ image | image_url: height: image_height_2x }} 2x, {{ image | image_url: height: image_height_3x }} 3x
    {%- endcapture %}

    {{
      image
      | image_url: height: image_height
      | image_tag: class: class, srcset: image_srcset, style: style_value, alt: image_alt_text, loading: image_loading, fetchpriority: image_fetchpriority, decoding: 'async'
    }}
  {% else %}
    {% assign image_widths = '375, 550, 750, 1100, 1500, 1780, 2000' %}
    {% assign image_sizes = '(min-width: 1200px) 1000px, (min-width: 750px) calc(50vw - 32px), 100vw' %}

    {{
      image
      | image_url: width: 1500
      | image_tag: class: class, widths: image_widths, sizes: image_sizes, style: style_value, alt: image_alt_text, loading: image_loading, fetchpriority: image_fetchpriority, decoding: 'async'
    }}
  {% endif %}
{% elsif text_fallback %}
  {{ text_fallback }}
{% endif %}
