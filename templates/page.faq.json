    "faq_accordion": {
      "type": "section",
      "blocks": {
        "faq_card": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "flex-start",
            "align_baseline": false,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "flex-start",
            "gap": 0,
            "width": "custom",
            "custom_width": 70,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_color": "#FFFCF8",
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "solid",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "{{ settings.color_palette.color3 }}",
            "border_radius": 12,
            "padding-block-start": 16,
            "padding-block-end": 16,
            "padding-inline-start": 32,
            "padding-inline-end": 32
          },
          "blocks": {
            "faq_list": {
              "type": "accordion",
              "settings": {
                "icon": "plus",
                "dividers": true,
                "type_preset": "h5",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {
                "row_processing": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Processing Times",
                    "open_by_default": true,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_processing": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Processing times vary by product and are listed on each product page. Please review the listed processing time before placing your order.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_processing"
                  ]
                },
                "row_shipping": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Shipping",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_shipping": {
                      "type": "text",
                      "settings": {
                        "text": "<p>We ship across the US via FedEx, UPS, and USPS, and tracking is included with every order. For full details, see our Shipping &amp; Returns page.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_shipping"
                  ]
                },
                "row_custom_orders": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Custom Orders",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_custom_orders": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Cherry Pop Craft Shop accepts custom requests for select 3D-designed pieces, including keychains, NFC accessories, payment stands, charms, and decorative items. Complete the Custom Orders form and include reference images whenever possible. We’ll review your request and follow up within two business days.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_custom_orders"
                  ]
                },
                "row_rush_orders": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Rush Orders",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_rush_orders": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Rush availability is not guaranteed. Please contact us before ordering to confirm whether your deadline can be accommodated. If accepted, a rush fee and upgraded shipping charge may apply.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_rush_orders"
                  ]
                },
                "row_returns": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Returns &amp; Cancellations",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_returns": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Returns are accepted within 14 days of delivery, provided the item is unused and undamaged. Custom products are not eligible for returns.</p><p>Because every item is made to order, orders cannot be cancelled once they have been placed.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_returns"
                  ]
                },
                "row_3d_texture": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "3D-Print Layer Lines &amp; Handmade Texture",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_3d_texture": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Many pieces are 3D-printed or handmade. Slight layer lines, texture, and finish variations are normal characteristics of the process and are not defects.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_3d_texture"
                  ]
                },
                "row_color_variation": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Color Variations",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_color_variation": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Screen settings can slightly affect how colors appear. We do our best to photograph items accurately, but minor color variation between photos and the finished piece can occur.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_color_variation"
                  ]
                },
                "row_damaged": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Damaged Orders",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_damaged": {
                      "type": "text",
                      "settings": {
                        "text": "<p>If your order arrives damaged or incorrect, please contact us within 48 hours of delivery and include photos so we can make it right.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_damaged"
                  ]
                },
                "row_care": {
                  "type": "_accordion-row",
                  "settings": {
                    "heading": "Care Instructions",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_care": {
                      "type": "text",
                      "settings": {
                        "text": "<ul><li>Faux icing should only be gently wiped with a dry cloth. Do not use water or submerge the item.</li><li>Resin and 3D-printed items may be wiped with a dry or slightly damp cloth.</li><li>When cleaning, avoid all faux-icing toppings and electrical components, including USB cords and fixtures.</li><li>No products should be submerged in water.</li></ul><p>For more details, see our Care Instructions page.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "paragraph",
                        "font": "var(--font-body--family)",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_care"
                  ]
                }
              },
              "block_order": [
                "row_processing",
                "row_shipping",
                "row_custom_orders",
                "row_rush_orders",
                "row_returns",
                "row_3d_texture",
                "row_color_variation",
                "row_damaged",
                "row_care"
              ]
            }
          },
          "block_order": [
            "faq_list"
          ]
        }
      },
      "block_order": [
        "faq_card"
      ],
